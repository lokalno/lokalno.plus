generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  storeName        String?
  city             String    @default("Київ")
  phone            String?
  avatar           String?
  banner           String?
  role             String    @default("USER")
  banned           Boolean   @default(false)
  bannedReason     String?
  balance          Float     @default(0)
  payoutCardHolder String?
  payoutCardNumber String?
  payoutBankName   String?
  createdAt        DateTime  @default(now())
  listings         Listing[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  ordersAsBuyer    Order[]   @relation("BuyerOrders")
  ordersAsSeller   Order[]   @relation("SellerOrders")
  reports          Report[]
  favorites   Favorite[]
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  following       SellerFollow[] @relation("Following")
  followers       SellerFollow[] @relation("Followers")
  supportTickets  SupportTicket[]
  supportReplies  SupportReply[]
  walletTransactions WalletTransaction[]
  withdrawals        Withdrawal[]
  priceOffers        PriceOffer[]
}

model SellerFollow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, sellerId])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  reviewerId String
  reviewer  User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  sellerId  String
  seller    User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  comment    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model Listing {
  id          String    @id @default(cuid())
  title       String
  description String
  price       Float
  category    String
  brand       String?
  condition   String
  city        String
  itemLocation String?
  vehicleYear Int?
  vehicleFuel String?
  vehicleTransmission String?
  vehicleBody String?
  vehicleMileage Int?
  vehicleType String?
  vehicleEngineVolume Int?
  vehicleLoadCapacity Int?
  partForVehicle String?
  partType String?
  partPopular String?
  status      String    @default("ACTIVE")
  photos      String
  stock       Int       @default(1)
  views       Int       @default(0)
  sellerId    String
  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  messages    Message[]
  reports     Report[]
  favorites        Favorite[]
  reviews          Review[]
  allowPriceOffers Boolean      @default(false)
  priceOffers      PriceOffer[]

  @@index([status, createdAt])
  @@index([status, city])
  @@index([status, category])
  @@index([sellerId, status])
}

model PriceOffer {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount      Float
  comment     String?
  status      String    @default("PENDING")
  orderId     String?   @unique
  order       Order?    @relation(fields: [orderId], references: [id])
  sellerRead  Boolean   @default(false)
  buyerStatusRead Boolean @default(true)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([listingId])
  @@index([buyerId, listingId])
  @@index([status])
}

model Order {
  id                 String   @id @default(cuid())
  orderNumber        Int      @unique @default(autoincrement())
  listingId          String
  listing            Listing  @relation(fields: [listingId], references: [id])
  buyerId            String
  buyer              User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId           String
  seller             User     @relation("SellerOrders", fields: [sellerId], references: [id])
  status             String   @default("PENDING")
  deliveryMethod     String   @default("NOVA_POSHTA")
  recipientFirstName String   @default("")
  recipientLastName  String   @default("")
  recipientPhone     String   @default("")
  deliveryOblast     String   @default("")
  deliveryRaion      String   @default("")
  deliveryCity       String   @default("")
  deliveryWarehouse  String   @default("")
  paymentStatus      String   @default("UNPAID")
  paidAt             DateTime?
  quantity           Int      @default(1)
  unitPrice          Float?
  priceOfferId       String?
  cancelledById      String?
  cancelledByRole    String?
  cancelReason       String?
  cancelReasonNote   String?
  cancelledAt        DateTime?
  novaPoshtaTtn      String?
  shippedAt          DateTime?
  createdAt          DateTime @default(now())
  priceOffer         PriceOffer?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([listingId])
  @@index([status, paymentStatus])
}

model Message {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([receiverId, read])
  @@index([senderId, listingId])
  @@index([listingId, createdAt])
}

model SiteSettings {
  id           Int     @id @default(1)
  siteName     String  @default("Локально")
  tagline      String  @default("Купуй і продавай локально в Україні")
  logoUrl      String?
  supportEmail   String  @default("support@lokalno.ua")
  rulesContent   String  @default("")
  privacyContent String  @default("")
  preModeration  Boolean @default(true)
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  phone       String?
  status      String         @default("OPEN")
  adminNote   String?
  adminUnread Boolean        @default(false)
  userUnread  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  replies     SupportReply[]
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAdmin   Boolean
  content   String
  createdAt DateTime      @default(now())
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float
  type         String
  description  String
  orderId      String?
  withdrawalId String?
  createdAt    DateTime @default(now())
}

model Withdrawal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float
  status       String    @default("PENDING")
  cardHolder   String
  cardLast4    String
  cardNumber   String
  bankName     String?
  adminNote    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
}
