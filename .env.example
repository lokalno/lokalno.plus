# Local: use Neon free PostgreSQL or Docker Postgres
# Pooled connection (Vercel/serverless) — host often contains "-pooler"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (migrations, prisma db push) — from Neon "Unpooled" or Vercel DATABASE_URL_UNPOOLED
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
NEXTAUTH_SECRET="change-this-to-a-long-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Production (Vercel → Settings → Environment Variables):
# DATABASE_URL     = Neon connection string
# NEXTAUTH_SECRET  = random string (Generate in Vercel or: openssl rand -base64 32)
# NEXTAUTH_URL     = https://lokalno.plus
# BLOB_READ_WRITE_TOKEN = optional, from Vercel → Storage → Blob (recommended for photos)
#
# Email (скидання пароля) — https://resend.com (безкоштовно до ~100 листів/день)
# RESEND_API_KEY   = re_...
# EMAIL_FROM       = Локально <noreply@lokalno.plus>  (домен lokalno.plus має бути підтверджений у Resend)
